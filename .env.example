# Ollama is primary: configure config/screening.local.yaml and experiment.local.yaml.
# No API key is needed for local Ollama. Variables below are optional OpenAI support.
# Do not commit your real API key.
OPENAI_API_KEY=

# Keep the model configurable. Fill this before running real experiments.
OPENAI_MODEL=

# Explicit returned snapshot versions are required; no implicit Judge fallback.
OPENAI_MODEL_VERSION=
OPENAI_JUDGE_MODEL=
OPENAI_JUDGE_MODEL_VERSION=

# Experiment defaults
GENERATOR_TEMPERATURE=0
JUDGE_TEMPERATURE=0
# MAX_RETRIES is fixed by protocol at 2, configured once in YAML.
MAX_TOKENS=

# This file is documentation only. CLI does not auto-load .env.
# Set environment variables explicitly in your shell; never place keys in config/.
